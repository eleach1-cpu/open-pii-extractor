{
  "name": "open-pii-extractor",
  "productName": "Open PII Extractor",
  "version": "1.2.0",
  "description": "Offline VA letter redactor by RateMyVSO.net. Auto-redacts PII from VA letters, then you check it. Nothing ever leaves your computer.",
  "main": "main.js",
  "license": "MIT",
  "author": "RateMyVSO.net",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/pii-redaction.test.js test/app-guards.test.js test/layout-redaction.test.js test/qr-boxes.test.js test/safety.test.js test/electron-smoke.test.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^4.5.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "net.ratemyvso.openpiiextractor",
    "productName": "Open PII Extractor",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/**",
      "!**/node_modules/@mapbox/node-pre-gyp/**",
      "!**/node_modules/tar/**"
    ],
    "asarUnpack": [
      "**/node_modules/canvas/**"
    ],
    "extraResources": [
      {
        "from": "assets/tessdata",
        "to": "tessdata"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "shortcutName": "Open PII Extractor"
    }
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
